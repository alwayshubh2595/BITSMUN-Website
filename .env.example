# Copy to .env for local dev, and set the same keys in your host's environment
# (Netlify/Vercel: Site settings -> Environment variables).
#
# NOTE: Vite inlines every VITE_* value into the built JS bundle. These are
# therefore PUBLIC — anyone can read them from the deployed site. Never put a
# credential here. The Apps Script endpoints below must do their own validation
# and must not treat "knows the URL" as authorisation.
#
# If any of these is unset at BUILD time, the corresponding form will fail fast
# with a visible error rather than silently dropping the submission.

VITE_SANITY_PROJECT_ID="h5reu7l4"

# Single Apps Script /exec endpoint serving all three registration forms.
# Source and deployment steps: scripts/apps-script/
VITE_REGFORM_URL=""

# Coupon lookup endpoints. These currently return the FULL code->discount map to
# the browser, so every coupon is publicly readable. Treat replacing them with a
# server-side "validate one code" endpoint as a follow-up.
VITE_COUPONS_URL=""
VITE_INTCOUPONS_URL=""
